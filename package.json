{
  "name": "lms-frontend",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run copy:vendor",
    "build:css": "tailwindcss -i frontend/main.css -o static/dist/main.css --minify",
    "watch:css": "tailwindcss -i frontend/main.css -o static/dist/main.css --watch",
    "copy:vendor": "node scripts/copy-vendor.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3",
    "htmx.org": "2.0.11",
    "vazirmatn": "33.0.3"
  }
}
