# Copy to .env for local development. In Coolify, set these as environment variables.
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=lms.araz.me
DJANGO_CSRF_TRUSTED_ORIGINS=https://lms.araz.me
# Path of the Django admin panel (keep it non-obvious)
DJANGO_ADMIN_URL=manage-panel/

POSTGRES_DB=lms
POSTGRES_USER=lms
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://lms:change-me@db:5432/lms
REDIS_URL=redis://redis:6379/0
